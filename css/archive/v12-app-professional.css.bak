/* IMPERIA v12 Pro App Look & Feel */
:root{
  --imp-bg:#07111f;
  --imp-surface:rgba(15,23,42,.82);
  --imp-card:rgba(255,255,255,.075);
  --imp-card-strong:rgba(255,255,255,.12);
  --imp-border:rgba(255,255,255,.12);
  --imp-text:#f8fafc;
  --imp-muted:#a7b4c8;
  --imp-primary:#22c55e;
  --imp-primary-2:#06b6d4;
  --imp-gold:#f59e0b;
  --imp-danger:#ef4444;
  --imp-shadow:0 24px 70px rgba(0,0,0,.32);
}
html{scroll-behavior:smooth} body{background:radial-gradient(circle at top left,rgba(34,197,94,.18),transparent 28%),radial-gradient(circle at 90% 0,rgba(56,189,248,.18),transparent 26%),var(--imp-bg);}
.app-shell{max-width:1220px;margin:0 auto;padding-bottom:112px;animation:appFade .45s ease both}.app-header{position:sticky;top:0;z-index:80;background:rgba(7,17,31,.72)!important;backdrop-filter:blur(24px);border-bottom:1px solid var(--imp-border)}
.logo-mark img{object-fit:contain}.topbar{gap:18px}.top-stats{gap:10px}.stat-pill,.status-chip,.badge,.tag{backdrop-filter:blur(12px);box-shadow:0 8px 24px rgba(0,0,0,.15)}
.btn,.question-option,.quiz-choice,.bottom-nav button{transition:transform .28s cubic-bezier(.2,.8,.2,1),box-shadow .28s ease,background .28s ease,border-color .28s ease,opacity .28s ease}.btn:hover,.pro-elevate:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(0,0,0,.25)}.btn:active,.question-option:active,.quiz-choice:active,.bottom-nav button:active{transform:scale(.96)}
.app-card,.activity-card,.course-card,.node-card,.profile-hero{background:linear-gradient(145deg,rgba(255,255,255,.105),rgba(255,255,255,.055));border:1px solid var(--imp-border);box-shadow:var(--imp-shadow);backdrop-filter:blur(18px)}
.app-card:hover,.activity-card:hover,.course-card:hover,.node-card:hover{border-color:rgba(34,197,94,.25)}
.course-grid.loaded-courses{animation:showCourses .7s ease .5s both}.skeleton-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-bottom:18px;animation:hideSkeleton .45s ease .55s both}.skeleton-grid span{height:190px;border-radius:28px;background:linear-gradient(90deg,rgba(255,255,255,.06),rgba(255,255,255,.15),rgba(255,255,255,.06));background-size:220% 100%;animation:skeletonPulse 1.1s linear infinite;border:1px solid rgba(255,255,255,.08)}
.courses-pro-screen .page-title{padding:18px 0}.course-card{position:relative;overflow:hidden}.course-card:before{content:"";position:absolute;inset:-40% auto auto -20%;width:180px;height:180px;background:radial-gradient(circle,rgba(34,197,94,.24),transparent 70%);pointer-events:none}.course-icon{background:linear-gradient(145deg,rgba(34,197,94,.24),rgba(6,182,212,.18));border:1px solid rgba(255,255,255,.13)}
.path-map .node{animation:floatIn .55s ease both}.path-map .node:nth-child(2){animation-delay:.08s}.path-map .node:nth-child(3){animation-delay:.16s}.path-map .node:nth-child(4){animation-delay:.24s}.node-bubble{animation:softBob 3.4s ease-in-out infinite}.node.available .node-bubble{box-shadow:0 0 0 7px rgba(34,197,94,.1),0 22px 45px rgba(34,197,94,.25)}
.einstein-avatar{filter:drop-shadow(0 24px 35px rgba(0,0,0,.28))}.profile-avatar-stage .einstein-avatar,.einstein-card .einstein-avatar{animation:einsteinFloat 3.2s ease-in-out infinite}.einstein-head .eye{animation:blink 4.8s infinite}.einstein-orbit{animation:orbitFloat 4s ease-in-out infinite}.profile-hero{overflow:hidden;position:relative}.profile-hero:after{content:"";position:absolute;right:-60px;top:-80px;width:260px;height:260px;border-radius:999px;background:radial-gradient(circle,rgba(34,197,94,.28),transparent 72%)}
.bottom-nav{position:fixed!important;left:max(12px,env(safe-area-inset-left));right:max(12px,env(safe-area-inset-right));bottom:max(12px,env(safe-area-inset-bottom));z-index:120;display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;padding:10px!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:28px!important;background:rgba(7,17,31,.86)!important;backdrop-filter:blur(26px);box-shadow:0 24px 70px rgba(0,0,0,.45)}.bottom-nav::-webkit-scrollbar{display:none}.bottom-nav button{min-width:82px;scroll-snap-align:center;border-radius:20px!important;padding:10px 12px!important;white-space:nowrap}.bottom-nav button.active{background:linear-gradient(135deg,var(--imp-primary),var(--imp-primary-2))!important;color:#04111f!important;box-shadow:0 12px 28px rgba(34,197,94,.28);animation:navPop .38s ease}.bottom-nav .ui-icon{width:21px;height:21px}
.quiz-shell{min-height:calc(100dvh - 20px);display:flex;flex-direction:column;padding:18px;max-width:760px;margin:0 auto;position:relative}.quiz-topbar{display:flex;align-items:center;gap:14px;position:sticky;top:12px;z-index:10}.circle{width:46px!important;height:46px!important;border-radius:999px!important;padding:0!important;display:grid!important;place-items:center!important}.quiz-progress{flex:1;height:16px;border-radius:999px;background:rgba(255,255,255,.11);overflow:hidden;border:1px solid rgba(255,255,255,.08)}.quiz-progress span{display:block;height:100%;background:linear-gradient(90deg,var(--imp-primary),var(--imp-primary-2));border-radius:999px;transition:width .55s ease}.quiz-life{min-width:62px;display:flex;align-items:center;gap:6px;font-weight:900;color:#fb7185;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);padding:12px 14px;border-radius:999px}.quiz-card-duo{margin-top:34px;padding:28px;border-radius:34px;background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.06));border:1px solid var(--imp-border);box-shadow:var(--imp-shadow)}.quiz-meta{display:flex;align-items:center;gap:14px;color:var(--imp-muted)}.quiz-meta>span{width:52px;height:52px;border-radius:18px;background:rgba(34,197,94,.13);display:grid;place-items:center;color:var(--imp-primary)}.quiz-meta small{display:block;margin-top:3px}.quiz-card-duo h1{font-size:clamp(1.55rem,4vw,2.45rem);line-height:1.08;margin:28px 0;font-weight:900}.quiz-options-duo{display:grid;gap:14px}.quiz-choice{width:100%;text-align:left;padding:18px 20px;border-radius:22px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.08);color:var(--imp-text);font-weight:800;font-size:1rem}.quiz-choice:hover{background:rgba(255,255,255,.14);transform:translateX(4px)}.quiz-choice.correct{background:rgba(34,197,94,.18);border-color:rgba(34,197,94,.65);box-shadow:0 12px 30px rgba(34,197,94,.16)}.quiz-choice.wrong{background:rgba(239,68,68,.18);border-color:rgba(239,68,68,.65);box-shadow:0 12px 30px rgba(239,68,68,.13)}.duo-feedback{position:fixed;left:0;right:0;bottom:0;z-index:200;transform:translateY(110%);transition:transform .42s cubic-bezier(.2,.8,.2,1);padding:18px;background:rgba(15,23,42,.97);border-top:1px solid rgba(255,255,255,.12);display:flex;justify-content:center;gap:16px}.duo-feedback.show{transform:translateY(0)}.duo-feedback>div,.duo-feedback>button{max-width:760px}.duo-feedback.success{background:linear-gradient(180deg,rgba(15,23,42,.98),rgba(6,78,59,.98))}.duo-feedback.danger{background:linear-gradient(180deg,rgba(15,23,42,.98),rgba(88,28,28,.98))}.duo-feedback h3{margin:0;font-size:1.25rem}.duo-feedback p{margin:.25rem 0 0;color:var(--imp-muted)}.quiz-result-card{max-width:620px;margin:auto;padding:34px;border-radius:36px;text-align:center;background:linear-gradient(145deg,rgba(255,255,255,.13),rgba(255,255,255,.06));border:1px solid rgba(255,255,255,.14);box-shadow:var(--imp-shadow)}.quiz-result-icon{width:88px;height:88px;border-radius:30px;margin:0 auto 18px;display:grid;place-items:center;background:rgba(34,197,94,.16);color:var(--imp-primary)}.quiz-result-icon .ui-icon{width:48px;height:48px}.quiz-actions{justify-content:center;margin-top:18px}.quiz-result-card h1{font-size:clamp(2rem,6vw,3rem);margin:0 0 8px}.tall{height:14px!important;margin:18px 0}
@keyframes skeletonPulse{to{background-position:-220% 0}}@keyframes hideSkeleton{to{opacity:0;height:0;margin:0;overflow:hidden}}@keyframes showCourses{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}@keyframes appFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes navPop{0%{transform:scale(.92)}60%{transform:scale(1.07)}100%{transform:scale(1)}}@keyframes floatIn{from{opacity:0;transform:translateY(22px) scale(.97)}to{opacity:1;transform:none}}@keyframes softBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}@keyframes einsteinFloat{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-10px) rotate(1deg)}}@keyframes blink{0%,92%,100%{transform:scaleY(1)}94%{transform:scaleY(.12)}}@keyframes orbitFloat{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-8px) rotate(8deg)}}
@media(max-width:760px){.app-shell{padding:10px 10px 116px}.app-header{border-radius:0 0 24px 24px}.topbar{align-items:flex-start}.top-stats{display:flex;overflow-x:auto;width:100%;padding-bottom:4px}.top-stats::-webkit-scrollbar{display:none}.stat-pill{flex:0 0 auto}.page-title{gap:14px}.reward-strip{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important}.skeleton-grid,.course-grid,.two-grid,.three-grid,.module-grid,.content-grid{grid-template-columns:1fr!important}.skeleton-grid span{height:160px}.course-card{border-radius:26px!important}.profile-hero{display:grid!important;gap:18px;text-align:left}.profile-avatar-stage{justify-self:center}.profile-speech{max-width:300px}.quiz-shell{padding:12px 12px 120px}.quiz-card-duo{border-radius:28px;padding:22px;margin-top:24px}.quiz-choice{padding:16px;border-radius:18px}.duo-feedback{display:grid;padding:16px 14px 20px}.duo-feedback .btn{width:100%}.bottom-nav button{min-width:74px;font-size:.74rem}.auth-grid{min-height:100dvh}.auth-hero,.auth-panel{border-radius:28px!important}}
@media(min-width:900px){.bottom-nav{max-width:760px;margin:0 auto;left:50%!important;right:auto!important;transform:translateX(-50%);width:calc(100% - 32px)}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}}
