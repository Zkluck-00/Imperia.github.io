<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>IMPERIA Pro | Plataforma Financiera Gamificada</title>
  <meta name="description" content="IMPERIA: plataforma gamificada de educación financiera con plan gratuito y premium, cursos, quizzes, prácticas y mentor virtual." />
  <meta name="theme-color" content="#11194f" />
  <link rel="icon" type="image/png" href="assets/favicon.png" />
  <link rel="apple-touch-icon" href="assets/icon-180.png" />
  <link rel="manifest" href="assets/manifest.json" />
  <link rel="stylesheet" href="css/tokens.css" />
  <link rel="stylesheet" href="css/layout.css" />
  <link rel="stylesheet" href="css/components.css" />
  <link rel="stylesheet" href="css/responsive.css" />
  <link rel="stylesheet" href="css/pro-polish.css" />
  <link rel="stylesheet" href="css/pro-final-fixes.css" />
  <link rel="stylesheet" href="css/responsive-v4.css?v=4" />
  <link rel="stylesheet" href="css/fluid-responsive-v5.css?v=5.1" />
  <link rel="stylesheet" href="css/mobile-hard-fix-v6.css?v=6.0.1" />
  <link rel="stylesheet" href="css/imperia-ui.css?v=9.0" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
  <link rel="stylesheet" href="css/v12-app-professional.css?v=12.0.0" />
</head>
<body>
  <div class="ambient" aria-hidden="true">
    <span class="orb orb-one"></span>
    <span class="orb orb-two"></span>
    <span class="orb orb-three"></span>
  </div>

  <main id="app"></main>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script src="js/data.js"></script>
  <script src="js/storage.js"></script>
  <script src="js/app.js"></script>
  <script src="js/ui-effects.js"></script>
  <script>if(window.AOS){AOS.init({duration:650, once:true, easing:"ease-out-cubic"});}</script>
  <script src="js/pwa.js"></script>
</body>
</html>
